{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/(overview|scanner|defects|map|workorders|verification|warranty|analytics|audit)",
      "destination": "/index.html"
    }
  ]
}